# Copy this file to `.env` and adjust for your local setup.
# Variables are optional; sensible defaults are used when unset.

# Base URL of your Jamcorder device (mDNS name or IP address).
# Used by the Express backend, the Vite dev/preview proxy, and the sidebar badge.
JAMCORDER_URL=http://jamcorder.local

# Optional: override where local data lives. Both accept a relative path
# (resolved from the repo root) or an absolute path outside the repo.
# JAMCODA_DB_PATH=./data/jamcoda.db
# JAMCODA_MIDI_DIR=./data/midi

# Optional: tune library API discovery and download pacing during sync. The
# Jamcorder firmware is resource-constrained and can crash under load, so keep
# pages small and pacing gentle.
# JAMCORDER_LIBRARY_PAGE_SIZE=5
# JAMCORDER_LIBRARY_PAGE_DELAY_MS=1000
# JAMCODA_SYNC_DOWNLOAD_PACE_MS=300
